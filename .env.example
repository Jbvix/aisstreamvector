# AISStream / KRATOS - exemplo de variáveis de ambiente
# Copie para .env (NUNCA commitar o .env real) ou configure no painel do cPanel.

# Porta do servidor
PORT=8080

# Modo de operação dos dados AIS: live | mock
AIS_MODE=live

# Chave da AISStream.io (https://aisstream.io) - mantenha em segredo
AISSTREAM_API_KEY=coloque_sua_chave_aqui

# Área padrão exibida ao abrir o app (ver dicionário AREAS no main.py)
DEFAULT_AREA=rio

# Identificador do usuário/tenant para a memória do dashboard estratégico
DASHBOARD_USER_ID=default

# Assistente estratégico KRATOS (xAI / Grok) - mantenha em segredo
XAI_API_KEY=coloque_sua_chave_xai_aqui
XAI_MODEL=grok-3-mini
